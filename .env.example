# SME Database (Railway - read-only, existing business/product data)
SME_DATABASE_URL=postgresql://user:password@your-railway-host:5432/railway

# Posts Database (local or separate - stores generated posts)
POSTS_DATABASE_URL=postgresql://user:password@localhost:5432/instagram_posts

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx

# LumaLabs
LUMALABS_API_KEY=your-lumalabs-key

# Meta Graph API (Instagram)
META_ACCESS_TOKEN=your-meta-access-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-ig-account-id

# Server
PORT=3000
