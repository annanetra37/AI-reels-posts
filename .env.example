# SME Database (Railway - read-only, existing business/product data)
SME_DATABASE_URL=postgresql://user:password@your-railway-host:5432/railway

# Posts Database (local or separate - stores generated posts)
POSTS_DATABASE_URL=postgresql://user:password@localhost:5432/instagram_posts

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx

# LumaLabs
LUMALABS_API_KEY=your-lumalabs-key

# Pika 2.2 via fal.ai (alternative video provider)
FAL_KEY=your-fal-key

# Meta Graph API (Instagram & Facebook)
META_ACCESS_TOKEN=your-meta-access-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-ig-account-id
FACEBOOK_PAGE_ID=your-facebook-page-id

# Cloudinary (for photo uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Freesound API (optional — get free key at https://freesound.org/apiv2/apply)
FREESOUND_API_KEY=

# Server
PORT=3000
